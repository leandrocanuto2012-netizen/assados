<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Assados Nobre | Gestão</title>
<style>
:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#18212f;background:#f4f6f9}*{box-sizing:border-box}body{margin:0}.top{background:#17243a;color:white;padding:18px 20px}.top h1{margin:0;font-size:20px}.top p{margin:5px 0 0;color:#cbd5e1;font-size:13px}.wrap{max-width:1100px;margin:auto;padding:18px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.tabs button,.btn{border:0;border-radius:9px;padding:11px 14px;background:#243752;color:#fff;font-weight:650;cursor:pointer}.tabs button[aria-selected=true]{background:#a84a22}.panel{display:none;background:white;border:1px solid #e1e6ed;border-radius:14px;padding:16px;margin-bottom:14px}.panel.active{display:block}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}label{display:block;font-size:13px;font-weight:650;color:#435064}input,select,textarea{width:100%;padding:11px;margin-top:5px;border:1px solid #cbd5e1;border-radius:8px;font:inherit}textarea{min-height:70px}form{display:grid;gap:12px}h2{font-size:18px;margin:0 0 14px}.hint{font-size:13px;color:#64748b}.status{padding:10px;background:#f1f5f9;border-radius:8px;margin:10px 0;font-size:13px;white-space:pre-wrap}.items{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}td,th{text-align:left;padding:9px;border-bottom:1px solid #e5eaf0;white-space:nowrap}.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}.kpi{background:#f8fafc;border:1px solid #e2e8f0;padding:14px;border-radius:10px}.kpi b{display:block;font-size:20px;margin-top:6px}.danger{background:#fff7ed;color:#9a3412;padding:10px;border-radius:8px;font-size:13px}@media(max-width:600px){.wrap{padding:12px}.panel{padding:12px}}
</style></head>
<body><header class="top"><h1>Assados Nobre ERP — Gestão</h1><p>Contabilidade · EDRAS · Jurídico · Filiais</p></header>
<main class="wrap"><section class="panel active" style="display:block"><h2>Meu painel</h2><div id="usuario-status" class="status">Carregando seu perfil…</div><div id="usuario-kpis" class="kpis"></div></section><div class="danger">Acesso sujeito às permissões do seu usuário. O módulo Jurídico pode conter dados confidenciais; não compartilhe esta tela nem documentos fora dos canais autorizados.</div>
<nav class="tabs" aria-label="Módulos"><button data-tab="filiais" aria-selected="true">Filiais</button><button data-tab="contabilidade" aria-selected="false">Contabilidade</button><button data-tab="edras" aria-selected="false">EDRAS</button><button data-tab="juridico" aria-selected="false">Jurídico</button></nav>
<section id="filiais" class="panel active"><h2>Dashboard das filiais</h2><p class="hint">A consolidação completa aparece somente para usuários autorizados pela matriz.</p><div id="filiais-status" class="status">Carregando indicadores…</div><div id="filiais-list" class="items"></div></section>
<section id="contabilidade" class="panel"><h2>Novo lançamento contábil</h2><form id="contab-form"><div class="grid"><label>Tipo<select name="tipo"><option value="receita">Receita</option><option value="despesa">Despesa</option><option value="transferencia">Transferência</option><option value="ajuste">Ajuste</option></select></label><label>Categoria<input name="categoria" maxlength="80" required></label><label>Valor (R$)<input name="valor" type="number" min="0" step="0.01" required></label><label>Competência<input name="competencia" type="date" required></label><label>Data do lançamento<input name="data_lancamento" type="date"></label><label>Centro de custo<input name="centro_custo" maxlength="100"></label></div><label>Descrição<input name="descricao" maxlength="240" required></label><label>Documento de referência<input name="documento_ref" maxlength="120"></label><button class="btn">Salvar como rascunho</button></form><div id="contab-status" class="status">Os lançamentos são gravados como rascunho e exigem permissão para confirmação.</div><h2>Lançamentos recentes</h2><button class="btn" data-load="contabilidade">Atualizar lista</button><div id="contab-list" class="items"></div></section>
<section id="edras" class="panel"><h2>EDRAS — Meu auxílio financeiro</h2><p class="hint">Organize seu orçamento pessoal: receitas, despesas, metas, dívidas e reservas. Os registros são privados por usuário.</p><form id="edras-form"><div class="grid"><label>Tipo<select name="tipo"><option value="receita">Receita</option><option value="despesa">Despesa</option><option value="meta">Meta</option><option value="divida">Dívida</option><option value="reserva">Reserva</option></select></label><label>Valor (R$)<input name="valor" type="number" min="0" step="0.01" required></label><label>Categoria<input name="categoria" maxlength="80"></label><label>Data<input name="data_referencia" type="date"></label><label>Vencimento<input name="vencimento" type="date"></label><label>Status<select name="status"><option value="planejado">Planejado</option><option value="realizado">Realizado</option></select></label></div><label>Descrição<input name="descricao" maxlength="200" required></label><label>Observações<textarea name="observacoes" maxlength="1000"></textarea></label><button class="btn">Adicionar ao meu planejamento</button></form><div id="edras-status" class="status"></div><h2>Meu planejamento</h2><button class="btn" data-load="edras">Atualizar lista</button><div id="edras-list" class="items"></div></section>
<section id="juridico" class="panel"><h2>Cadastro de processo / assunto jurídico</h2><p class="hint">Use apenas para controle administrativo. Prazos legais devem ser conferidos pelo advogado responsável.</p><form id="juridico-form"><div class="grid"><label>Tipo<input name="tipo" maxlength="80" required placeholder="Trabalhista, cível…"></label><label>Número do processo<input name="numero_processo" maxlength="100"></label><label>Responsável<input name="responsavel" maxlength="160" required></label><label>Advogado<input name="advogado" maxlength="160"></label><label>Próximo prazo<input name="proximo_prazo" type="date"></label><label>Sigilo<select name="nivel_sigilo"><option value="restrito">Restrito</option><option value="confidencial">Confidencial</option></select></label></div><label>Título<input name="titulo" maxlength="240" required></label><label>Parte contrária<input name="parte_contraria" maxlength="200"></label><label>Observações<textarea name="observacoes" maxlength="2000"></textarea></label><button class="btn">Registrar assunto</button></form><div id="juridico-status" class="status">Documentos devem ficar em armazenamento privado; upload ainda não está habilitado nesta versão.</div><h2>Processos da minha filial</h2><button class="btn" data-load="juridico">Atualizar lista</button><div id="juridico-list" class="items"></div></section>
</main>
<script>
'use strict';
const API='/api/gestao';
const $=s=>document.querySelector(s);
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
async function api(path,options={}){const r=await fetch(API+path,{...options,headers:{'Content-Type':'application/json',...(options.headers||{})},credentials:'same-origin'});let j={};try{j=await r.json()}catch{}if(!r.ok||j.sucesso===false)throw new Error(j.erro||`Erro HTTP ${r.status}`);return j}
function table(target,rows,cols){const el=$(target);if(!rows?.length){el.innerHTML='<p class="hint">Nenhum registro encontrado.</p>';return}el.innerHTML='<table><thead><tr>'+cols.map(c=>'<th>'+c[1]+'</th>').join('')+'</tr></thead><tbody>'+rows.map(row=>'<tr>'+cols.map(c=>'<td>'+String(c[2](row)??'—').replace(/[&<>"']/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[x]))+'</td>').join('')+'</tr>').join('')+'</tbody></table>'}
async function loadUsuario(){
 try{const j=await api('/dashboard/meu-painel');
 $('#usuario-status').textContent=`${j.usuario.nome} · Perfil: ${j.usuario.perfil} · Unidade: ${j.usuario.unidade_id}`;
 $('#usuario-kpis').innerHTML=[['Receitas EDRAS',j.edras.receitas],['Despesas EDRAS',j.edras.despesas],['Metas',j.edras.metas],['Movimentos',j.edras.movimentos]].map(([n,v])=>`<div class="kpi">${n}<b>${typeof v==='number'&&n.includes('EDRAS')?money(v):v}</b></div>`).join('');
 }catch(e){$('#usuario-status').textContent=e.message}
}
async function loadFiliais(){try{const j=await api('/dashboard/filiais');$('#filiais-status').textContent=`${j.unidades.length} unidade(s) com acesso permitido.`;table('#filiais-list',j.unidades,[['id','Unidade',x=>x.unidade_id],['r','Receitas',x=>money(x.receitas)],['d','Despesas',x=>money(x.despesas)],['n','Lançamentos',x=>x.lancamentos]])}catch(e){$('#filiais-status').textContent=e.message}}
async function loadContab(){try{const j=await api('/contabilidade/lancamentos');table('#contab-list',j.itens,[['c','Competência',x=>x.competencia],['t','Tipo',x=>x.tipo],['d','Descrição',x=>x.descricao],['v','Valor',x=>money(x.valor)],['s','Status',x=>x.status]])}catch(e){$('#contab-status').textContent=e.message}}
async function loadEdras(){try{const j=await api('/edras/movimentos');table('#edras-list',j.itens,[['d','Data',x=>x.data_referencia],['t','Tipo',x=>x.tipo],['n','Descrição',x=>x.descricao],['v','Valor',x=>money(x.valor)],['s','Status',x=>x.status]])}catch(e){$('#edras-status').textContent=e.message}}
async function loadJuridico(){try{const j=await api('/juridico/processos');table('#juridico-list',j.itens,[['n','Processo',x=>x.numero_processo],['t','Título',x=>x.titulo],['r','Responsável',x=>x.responsavel],['s','Status',x=>x.status],['p','Próximo prazo',x=>x.proximo_prazo]])}catch(e){$('#juridico-status').textContent=e.message}}
const loaders={filiais:loadFiliais,contabilidade:loadContab,edras:loadEdras,juridico:loadJuridico};
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.setAttribute('aria-selected',String(x===b)));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.id===b.dataset.tab));loaders[b.dataset.tab]?.()}));
document.querySelectorAll('[data-load]').forEach(b=>b.addEventListener('click',()=>loaders[b.dataset.load]?.()));
function formData(form){return Object.fromEntries(new FormData(form).entries())}
async function submit(id,path,statusId,after){$(id).addEventListener('submit',async e=>{e.preventDefault();const status=$(statusId);status.textContent='Salvando…';try{await api(path,{method:'POST',body:JSON.stringify(formData(e.currentTarget))});status.textContent='Registro salvo com sucesso.';e.currentTarget.reset();await after()}catch(err){status.textContent=err.message}})}
submit('#contab-form','/contabilidade/lancamentos','#contab-status',loadContab);
submit('#edras-form','/edras/movimentos','#edras-status',loadEdras);
submit('#juridico-form','/juridico/processos','#juridico-status',loadJuridico);
loadUsuario();loadFiliais();
</script></body></html>
